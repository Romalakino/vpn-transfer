{
  "log": { "level": "warn" },
  "dns": {
    "servers": [{ "tag": "dns-direct", "type": "udp", "server": "1.1.1.1" }]
  },
  "inbounds": [
    { "type": "tun", "tag": "tun-in", "interface_name": "tun0",
      "address": "172.19.0.1/30", "auto_route": true, "stack": "system" },
    { "type": "socks", "tag": "socks-in", "listen": "127.0.0.1", "listen_port": 10808 },
    { "type": "http", "tag": "http-in", "listen": "127.0.0.1", "listen_port": 10809 }
  ],
  "outbounds": [{ "type": "direct", "tag": "direct" }],
  "route": {
    "rules": [
      { "inbound": ["tun-in", "socks-in", "http-in"], "outbound": "direct" }
    ]
  }
}
