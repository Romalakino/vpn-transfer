#!/bin/bash
# VPN auto-ping: measure latency to all servers, cache results
# Called by systemd timer every hour + at boot

SERVERS="/home/vlad/.local/share/vpn/servers.txt"
CACHE="/tmp/vpn-latency.json"
TMP="/tmp/vpn-ping.tmp"

> "$TMP"

while IFS= read -r line; do
    [[ "$line" != vless://* ]] && continue
    host_port="${line#*@}"; host_port="${host_port%%\?*}"
    host_port="${host_port%%\#*}"; host_port="${host_port%%/*}"
    h="${host_port%%:*}"; p="${host_port##*:}"
    [ -z "$h" ] || [ -z "$p" ] && continue
    
    ms=$(timeout 2 bash -c "
        s=\$(date +%s%3N)
        echo >/dev/tcp/$h/$p 2>/dev/null
        e=\$(date +%s%3N)
        echo \$(( e - s ))
    " 2>/dev/null) || ms=""
    echo "${h}:${p}|${ms}" >> "$TMP" &
done < "$SERVERS"
wait

python3 <(cat << 'PYEOF'
import json, os
data = {}
for line in open("/tmp/vpn-ping.tmp"):
    parts = line.strip().split("|")
    if len(parts) == 2:
        key, ms = parts
        data[key] = int(ms) if ms and ms.isdigit() else -1
with open("/tmp/vpn-latency.json", "w") as f:
    json.dump(data, f)
PYEOF
)

alive=$(grep -cP '\|[0-9]+' "$TMP" 2>/dev/null || echo 0)
total=$(grep -c . "$TMP" 2>/dev/null || echo 0)
echo "ping: $alive/$total alive"
