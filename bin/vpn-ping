#!/bin/bash
# Hourly: real server check. Three independent results per server:
#   ping  = real network RTT (ICMP, fallback TCP-connect SYN-ACK) — честный пинг
#   alive = ✓ только если VLESS-рукопожатие реально проксирует трафик
#   gpt   = [GPT] если chatgpt.com отвечает 200 (curl_cffi, браузерный TLS)
# Skips when VPN is ON (results unreliable).

if [ "$(tr -d '\n' < /tmp/vpn-status 2>/dev/null)" = "ON" ]; then
    exit 0
fi

GPT_TESTER="/tmp/gptvenv/bin/python"
if [ ! -x "$GPT_TESTER" ]; then
    python3 -m venv /tmp/gptvenv 2>/dev/null
    /tmp/gptvenv/bin/pip install -q curl_cffi 2>/dev/null
fi

exec /tmp/gptvenv/bin/python - << 'PYEOF'
import urllib.parse, socket, os, re, json, subprocess, time, tempfile
from concurrent.futures import ThreadPoolExecutor

SBIN = "/home/vlad/.local/bin/sing-box"
CACHE = "/tmp/vpn-prescan-cache.txt"
GPT_RESULTS = "/tmp/vpn-gpt-cache.json"
TEST_HOST = "https://icanhazip.com"
BASE_PORT = 10820
MAX_WORKERS = 6

def measure_rtt(host, port):
    # 1) ICMP ping — самый честный RTT
    try:
        out = subprocess.run(["ping", "-c", "1", "-W", "2", host],
                             capture_output=True, text=True, timeout=4)
        m = re.search(r"time=([0-9.]+)\s*ms", out.stdout)
        if m:
            return int(float(m.group(1)))
    except:
        pass
    # 2) TCP SYN-ACK RTT (если ICMP заблокирован)
    try:
        s = socket.socket()
        t0 = time.time()
        s.settimeout(2)
        s.connect((host, port))
        s.close()
        return int((time.time() - t0) * 1000)
    except:
        return None

servers = []
for line in open("/home/vlad/.local/share/vpn/servers.txt"):
    line = line.strip()
    if not line.startswith("vless://"): continue
    try:
        uuid = line.split("@")[0][8:]
        params_str = line.split("?")[1].split("#")[0]
        params = dict(kv.split("=", 1) for kv in params_str.split("&") if "=" in kv)
        host_port = line.split("@", 1)[1].split("?")[0].split("#")[0].rstrip("/")
        h, p = host_port.split(":")
        name = urllib.parse.unquote(line.split("#")[1]) if "#" in line else ""
        name = re.sub(r"\[GPT\]\s*", "", name)
        security = params.get("security", "tls")
        fp = params.get("fp", "firefox")
        sni = params.get("sni", h)
        servers.append({
            "host": h, "sport": int(p), "name": name, "uuid": uuid,
            "security": security, "fp": fp, "sni": sni,
            "pbk": params.get("pbk", ""), "sid": params.get("sid", ""),
        })
    except:
        continue

for i, e in enumerate(servers):
    e["lport"] = BASE_PORT + i

def make_config(e):
    tls = {"enabled": True, "server_name": e["sni"],
           "utls": {"enabled": True, "fingerprint": e["fp"]}}
    if e["security"] == "reality":
        tls["reality"] = {"enabled": True, "public_key": e["pbk"], "short_id": e["sid"]}
    return {
        "log": {"level": "error"},
        "inbounds": [{"type": "socks", "listen": "127.0.0.1", "listen_port": e["lport"]}],
        "outbounds": [{
            "type": "vless", "tag": "proxy",
            "server": e["host"], "server_port": e["sport"],
            "uuid": e["uuid"], "flow": "xtls-rprx-vision",
            "tls": tls,
        }],
    }

def socks_up(port):
    s = socket.socket()
    s.settimeout(0.4)
    try:
        s.connect(("127.0.0.1", port)); s.close(); return True
    except:
        return False

def gpt_check(lport):
    # ChatGPT via browser TLS fingerprint (curl_cffi impersonate) — curl gives fake 403
    try:
        from curl_cffi import requests
        r = requests.get("https://chatgpt.com/", impersonate="chrome124", timeout=8,
            proxies={"https": f"socks5h://127.0.0.1:{lport}",
                     "http": f"socks5h://127.0.0.1:{lport}"})
        return str(r.status_code)
    except Exception as ex:
        return "ERR:" + type(ex).__name__

# Countries where Gemini geo-blocks (RU/BY and others)
GEMINI_BLOCKED = {"RU", "BY", "CN", "IR", "KP", "CU", "SY", "VE"}

def gemini_check(lport):
    # Gemini blocks by exit-IP country (client-side, page HTML is identical).
    # Check exit country via ip-api.com through the socks proxy.
    try:
        from curl_cffi import requests
        r = requests.get("http://ip-api.com/json/", timeout=6,
            proxies={"https": f"socks5h://127.0.0.1:{lport}",
                     "http": f"socks5h://127.0.0.1:{lport}"})
        cc = r.json().get("countryCode", "")
        if cc in GEMINI_BLOCKED:
            return "BLOCK"
        return "OK" if cc else "ERR"
    except Exception:
        return "ERR"

def check(e):
    key = f"{e['host']}:{e['sport']}"
    rtt = measure_rtt(e["host"], e["sport"])
    cfg = os.path.join(tempfile.gettempdir(), f"vpn-ping-{e['lport']}.json")
    with open(cfg, "w") as f:
        json.dump(make_config(e), f)

    proc = subprocess.Popen([SBIN, "run", "-c", cfg],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    alive = False
    gpt = None
    gem = None
    try:
        t0 = time.time()
        deadline = t0 + 7
        while time.time() < deadline:
            if proc.poll() is not None:
                return key, rtt, False, None, None
            if socks_up(e["lport"]):
                break
            time.sleep(0.15)
        out = subprocess.run(
            ["curl", "-x", f"socks5h://127.0.0.1:{e['lport']}", "-s", "--max-time", "5", TEST_HOST],
            capture_output=True, text=True, timeout=8).stdout.strip()
        if re.match(r"^\d+\.\d+\.\d+\.\d+$", out):
            alive = True
            gpt = gpt_check(e["lport"])
            gem = gemini_check(e["lport"])
    except:
        pass
    finally:
        proc.terminate()
        try: proc.wait(timeout=2)
        except: proc.kill()
        os.unlink(cfg)
    return key, rtt, alive, gpt, gem

results = {}
def run(e):
    key, rtt, alive, gpt, gem = check(e)
    results[key] = (rtt, alive, gpt, gem, e["name"])

with ThreadPoolExecutor(max_workers=MAX_WORKERS) as ex:
    for e in servers:
        ex.submit(run, e)

lines = []
gpt_cache = {}
gem_cache = {}
for e in servers:
    key = f"{e['host']}:{e['sport']}"
    rtt, alive, gpt, gem, name = results.get(key, (None, False, None, None, e["name"]))
    gpt_cache[key] = gpt
    gem_cache[key] = gem
    if alive:
        rtt_str = f" {rtt}ms" if rtt is not None else ""
        gpt_str = " [GPT]" if gpt == "200" else ""
        gem_str = " [GEM]" if gem == "OK" else ""
        lines.append(f"{e['host']}|{e['sport']}|✓{rtt_str}{gpt_str}{gem_str} {name}")
    else:
        lines.append(f"{e['host']}|{e['sport']}|✗ {name}")

with open(CACHE, "w") as f:
    f.write("\n".join(lines) + "\n")
with open(GPT_RESULTS, "w") as f:
    json.dump(gpt_cache, f, indent=2)
with open("/tmp/vpn-gemini-cache.json", "w") as f:
    json.dump(gem_cache, f, indent=2)

alive = sum(1 for rtt, ok, gpt, gem, name in results.values() if ok)
gpt_ok = sum(1 for rtt, ok, gpt, gem, name in results.values() if ok and gpt == "200")
gem_ok = sum(1 for rtt, ok, gpt, gem, name in results.values() if ok and gem == "OK")
print(f"check: {len(servers)}, handshake-ok: {alive}, chatgpt-ok: {gpt_ok}, gemini-ok: {gem_ok}")
PYEOF
