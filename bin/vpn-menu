#!/bin/bash
set -euo pipefail

CACHE="/tmp/vpn-prescan-cache.txt"
SERVERS="/home/vlad/.local/share/vpn/servers.txt"
STATUS="/tmp/vpn-status"
WOFI_CFG="$HOME/.config/wofi/menu"

[[ "$(cat $STATUS 2>/dev/null)" == "ON" ]] && echo -e "■  OFF — выключить VPN\n"

python3 <(cat << 'PYEOF'
import urllib.parse, sys, os

cache = {}
if os.path.exists("/tmp/vpn-prescan-cache.txt"):
    for line in open("/tmp/vpn-prescan-cache.txt"):
        parts = line.strip().split("|", 2)
        if len(parts) >= 3:
            cache[f"{parts[0]}:{parts[1]}"] = parts[2]

servers = []
with open("/home/vlad/.local/share/vpn/servers.txt") as f:
    for line in f:
        line = line.strip()
        if not line.startswith("vless://"):
            continue
        try:
            host_port = line.split("@", 1)[1].split("?")[0].split("#")[0].rstrip("/")
            h, p = host_port.split(":")
            name = urllib.parse.unquote(line.split("#")[1]) if "#" in line else "Unknown"
            servers.append((h, p, name, line))
        except:
            continue

flag = lambda c: {"GB":"🇬🇧","TR":"🇹🇷","NL":"🇳🇱","DE":"🇩🇪","US":"🇺🇸",
                   "FR":"🇫🇷","CA":"🇨🇦","CH":"🇨🇭","IR":"🇮🇷","SE":"🇸🇪",
                   "NO":"🇳🇴","FI":"🇫🇮","DK":"🇩🇰","PL":"🇵🇱","UA":"🇺🇦",
                   "IT":"🇮🇹","ES":"🇪🇸","PT":"🇵🇹","BR":"🇧🇷","AU":"🇦🇺",
                   "JP":"🇯🇵","KR":"🇰🇷","SG":"🇸🇬","HK":"🇭🇰","IN":"🇮🇳",
                   "CZ":"🇨🇿","AT":"🇦🇹","BE":"🇧🇪","RO":"🇷🇴","BG":"🇧🇬",
                   "SK":"🇸🇰","HU":"🇭🇺","LV":"🇱🇻","LT":"🇱🇹","EE":"🇪🇪",
                   "LU":"🇱🇺","IE":"🇮🇪","GR":"🇬🇷","CY":"🇨🇾","MT":"🇲🇹",
                   "VN":"🇻🇳","TH":"🇹🇭","ID":"🇮🇩","PH":"🇵🇭","MY":"🇲🇾",
                   "KZ":"🇰🇿","AZ":"🇦🇿","GE":"🇬🇪","AM":"🇦🇲","MD":"🇲🇩",
                   "IS":"🇮🇸"}.get(c, "")

for h, p, name, url in servers:
    key = f"{h}:{p}"
    cached = cache.get(key, "")
    status = "✓" if cached and not cached.startswith("✗") else " "
    cc = ""
    emoji = ""
    rest = name
    for word in name.split():
        if len(word) == 2 and word.isupper() and word.isalpha():
            cc = word
            emoji = flag(word)
            break
    rest = name.replace(f" {cc}", "").replace(cc + " ", "").strip() if cc else name
    
    speed = ""
    if "Mbps" in rest:
        parts = rest.rsplit("Mbps", 1)
        speed_val = parts[0].strip().split()[-1]
        speed = f"{speed_val}Mbps"
        rest = rest.replace(f" {speed_val}Mbps", "").strip()
        try:
            rest = rest.rsplit(" ", 1)[0] if rest.split()[-1].replace(".","").isdigit() else rest
        except:
            pass
    
    label = f"{status} {emoji} {rest}"
    if speed:
        label += f"  <span size='small' color='#888'>({speed})</span>"
    
    print(label)
PYEOF
) | wofi --dmenu -i -p "VPN" --width 450 --height 320 2>/dev/null