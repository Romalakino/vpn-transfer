#!/bin/bash
# VPN pre-scan: measure real latency BEFORE VPN connects
# Called by systemd timer at boot + hourly

SERVERS="/home/vlad/.local/share/vpn/servers.txt"
CACHE="/tmp/vpn-prescan-cache.txt"
LATENCY="/tmp/vpn-latency.json"
TMP="/tmp/vpn-alive.tmp"

rm -f "$CACHE" "$TMP" >/dev/null 2>&1

total=$(grep -c "^vless://" "$SERVERS" 2>/dev/null || echo 0)
echo "scan: $total servers"

> "$TMP"

while IFS= read -r line; do
    [[ "$line" != vless://* ]] && continue
    host_port="${line#*@}"; host_port="${host_port%%\?*}"
    host_port="${host_port%%\#*}"; host_port="${host_port%%/*}"
    h="${host_port%%:*}"; p="${host_port##*:}"
    [ -z "$h" ] || [ -z "$p" ] && continue
    
    ms=$(ping -c 1 -W 1 "$h" 2>/dev/null | grep -oP 'time=\K[0-9.]+' | head -1)
    alive=""
    if [ -n "$ms" ]; then
        alive="✓"
        ms_int="${ms%.*}"
    else
        ms_int="-1"
    fi
    
    echo "$line" >> "$TMP"
    echo "${h}:${p}|${ms_int}" >> "${TMP}.lat" &
done < "$SERVERS"
wait

alive_count=$(grep -c . "$TMP" 2>/dev/null || echo 0)

python3 <(cat << 'PYEOF'
import urllib.parse, json

data = {}
for line in open("/tmp/vpn-alive.tmp.lat"):
    p = line.strip().split("|")
    if len(p) == 2:
        key = p[0]
        try: data[key] = int(float(p[1]))
        except: data[key] = -1

with open("/tmp/vpn-latency.json", "w") as f:
    json.dump(data, f)

cache_lines = []
for line in open("/home/vlad/.local/share/vpn/servers.txt"):
    line = line.strip()
    if not line.startswith("vless://"): continue
    try:
        after_at = line.split("@", 1)[1]
        host_port = after_at.split("?")[0].split("#")[0].rstrip("/")
        h, p = host_port.split(":")
        name = urllib.parse.unquote(line.split("#")[1]) if "#" in line else ""
    except: continue
    key = f"{h}:{p}"
    ms = data.get(key, -1)
    if ms > 0:
        cache_lines.append(f"{h}|{p}|✓ {ms}ms {name}")
    else:
        cache_lines.append(f"{h}|{p}|✗ {name}")

with open("/tmp/vpn-prescan-cache.txt", "w") as f:
    f.write("\n".join(cache_lines) + "\n")
PYEOF
)

echo "done: $alive_count/$total alive (ICMP ping)"
