#!/bin/bash
# VPN pre-scan: TCP ping all servers → cache alive/dead status

SERVERS="/home/vlad/.local/share/vpn/servers.txt"
CACHE="/tmp/vpn-prescan-cache.txt"
TMP_ALIVE="/tmp/vpn-alive.tmp"

rm -f "$CACHE" "$TMP_ALIVE"

total=$(grep -c "^vless://" "$SERVERS" 2>/dev/null || echo 0)
echo "🔍 Scanning $total servers..."

# Fast TCP check in parallel
while IFS= read -r line; do
    [[ "$line" != vless://* ]] && continue
    host_port="${line#*@}"
    host_port="${host_port%%\?*}"
    host_port="${host_port%%\#*}"
    host_port="${host_port%%/*}"
    h="${host_port%%:*}"
    p="${host_port##*:}"
    timeout 2 bash -c "echo >/dev/tcp/$h/$p" 2>/dev/null && echo "$line" >> "$TMP_ALIVE" &
done < "$SERVERS"
wait

alive_count=$(wc -l < "$TMP_ALIVE" 2>/dev/null || echo 0)
echo "✅ Alive: $alive_count / $total"

# Generate cache — all servers with markers
python3 <(cat << 'PYEOF'
import urllib.parse, os

alive = set()
if os.path.exists("/tmp/vpn-alive.tmp"):
    alive = set(l.strip() for l in open("/tmp/vpn-alive.tmp") if l.strip())

with open("/home/vlad/.local/share/vpn/servers.txt") as f:
    for line in f:
        line = line.strip()
        if not line.startswith("vless://"):
            continue
        try:
            after_at = line.split("@", 1)[1]
            host_port = after_at.split("?")[0].split("#")[0].rstrip("/")
            h, p = host_port.split(":")
            name = urllib.parse.unquote(line.split("#")[1]) if "#" in line else ""
            status = "" if line in alive else "✗"
            print(f"{h}|{p}|{status} {name}")
        except:
            pass
PYEOF
) > "$CACHE"

echo "💾 Cached → $CACHE"
