#!/bin/bash
# vpn-recover — полное восстановление сети, если что-то пошло не так
# Использование: sudo bash /tmp/opencode/vpncheck/vpn-recover.sh
# (или установи в ~/.local/bin/vpn-recover)

echo "[1/5] Убиваю все VPN-процессы..."
pkill -9 -f sing-box 2>/dev/null
pkill -9 -f xray 2>/dev/null
pkill -9 -f nfqws 2>/dev/null
pkill -9 -f redsocks 2>/dev/null
pkill -9 -f wg-quick 2>/dev/null

echo "[2/5] Сбрасываю маршрутизацию (таблицы 2022, политики)..."
ip route flush table 2022 2>/dev/null
ip route flush cache 2>/dev/null
while ip rule show | grep -q 'lookup 2022'; do
    ip rule del lookup 2022 2>/dev/null
done
ip rule flush table 2022 2>/dev/null
ip rule restore < /tmp/opencode/vpncheck/rules.bak 2>/dev/null

echo "[3/5] Восстанавливаю маршруты из снапшота..."
if [ -s /tmp/opencode/vpncheck/routes.bak ]; then
    ip route restore < /tmp/opencode/vpncheck/routes.bak 2>/dev/null
else
    ip route del 0.0.0.0/1 2>/dev/null
    ip route del 128.0.0.0/1 2>/dev/null
    ip route del default via 192.168.1.1 2>/dev/null
fi

echo "[4/5] Сбрасываю iptables/nftables..."
iptables -t mangle -F 2>/dev/null
iptables -t nat -F 2>/dev/null
iptables -t mangle -X 2>/dev/null
iptables -t nat -X 2>/dev/null
if [ -s /tmp/opencode/vpncheck/iptables.bak ]; then
    iptables-restore < /tmp/opencode/vpncheck/iptables.bak 2>/dev/null
fi
systemctl restart NetworkManager 2>/dev/null

echo "[5/5] Восстанавливаю DNS..."
cp /tmp/opencode/vpncheck/resolv.conf.bak /etc/resolv.conf 2>/dev/null
systemctl restart systemd-resolved 2>/dev/null

sleep 2
echo "--- ПРОВЕРКА ---"
ip route show default
if ping -c 2 -W 2 1.1.1.1 >/dev/null 2>&1 || ping -c 2 -W 2 8.8.8.8 >/dev/null 2>&1; then
    echo "OK: сеть работает"
else
    echo "ПРЕДУПРЕЖДЕНИЕ: сеть не поднялась, проверь NetworkManager: nmcli dev status"
fi
